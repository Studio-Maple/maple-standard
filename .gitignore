# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the committed shape; everything else stays local
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — personal/local overlay (the .example is committed)
.claude/settings.local.json

# playwright
/e2e/playwright-report/
/e2e/test-results/
/playwright-report/
/test-results/

# supabase local state
/supabase/.branches
/supabase/.temp

# tool caches / reports
.eslintcache
depcruise-report.html

# docs lockfiles (next-task-id.mjs mutex leftovers after a crash)
docs/*.lock
