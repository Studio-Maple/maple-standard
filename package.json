{
  "name": "maple-standard",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js (App Router, TypeScript) + Supabase + Vercel starter with a built-in quality/observability/security framework.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "knip": "node scripts/run-knip.mjs",
    "depcruise": "depcruise --config .dependency-cruiser.cjs --output-type err src",
    "depcruise:report": "depcruise --config .dependency-cruiser.cjs --output-type err-html --output-to depcruise-report.html src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:plugin-loops": "node plugin/scripts/loops/run-tests.mjs",
    "test:plugin-agent-wt": "node plugin/scripts/agent-wt/run-tests.mjs",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:smoke": "playwright test --config e2e/playwright.config.ts --grep @smoke",
    "test:supabase": "node supabase/tests/run-db-tests.mjs",
    "docs:drift": "node scripts/check-docs-drift.mjs",
    "docs:drift:fix": "node scripts/check-docs-drift.mjs --fix",
    "docs:index": "node scripts/generate-docs-index.mjs",
    "docs:search": "node scripts/doc-search/search.mjs",
    "next-id": "node scripts/next-task-id.mjs",
    "ci:fast": "bash scripts/ci-local.sh fast",
    "ci:gate": "bash scripts/ci-local.sh gate",
    "ci:core": "bash scripts/ci-local.sh core",
    "ci:full": "bash scripts/ci-local.sh full",
    "ci:fast:win": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 fast",
    "ci:gate:win": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 gate",
    "ci:core:win": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 core",
    "ci:full:win": "powershell -ExecutionPolicy Bypass -File scripts/ci-local.ps1 full",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status -o env",
    "supabase:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "supabase:types:check": "node scripts/check-types-fresh.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.72.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.33.0",
    "msw": "^2.15.0",
    "supabase": "^2.116.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
