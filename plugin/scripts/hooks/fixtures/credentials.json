[
  {
    "setup": {},
    "cases": [
      { "name": "cat .env.example", "input": { "command": "cat .env.example" }, "expect": "allow" },
      { "name": "cat .env.sample / .env.template", "input": { "command": "cat .env.sample && cat apps/web/.env.template" }, "expect": "allow" },
      { "name": "commit message names .env", "input": { "command": "git commit -m \"docs: document .env and .dev.vars handling\"" }, "expect": "allow" },
      { "name": "heredoc commit message names .env", "input": { "command": "git commit -m \"$(cat <<'EOF'\nfix: never read .env.local or id_rsa\nEOF\n)\"" }, "expect": "allow" },
      { "name": "gh pr body names .env", "input": { "command": "gh pr create --title \"x\" --body \"mentions .env.local in the text\"" }, "expect": "allow" },
      { "name": "echo text naming .env", "input": { "command": "echo \"copy .env.example to .env.local\"" }, "expect": "allow" },
      { "name": "process.env is not a file", "input": { "command": "node -e \"console.log(process.env.NODE_ENV)\"" }, "expect": "allow" },
      { "name": "public key and cert pem", "input": { "command": "cat id_rsa.pub server-cert.pem" }, "expect": "allow" },
      { "name": "ordinary commands", "input": { "command": "ls -la && cat README.md" }, "expect": "allow" },
      { "name": "Read .env.example", "tool": "Read", "input": { "file_path": "C:/p/.env.example" }, "expect": "allow" },
      { "name": "Read src/env.ts", "tool": "Read", "input": { "file_path": "C:/p/src/env.ts" }, "expect": "allow" },
      { "name": "Grep a content pattern that looks like a path", "tool": "Grep", "input": { "pattern": "\\.env", "path": "C:/p/src" }, "expect": "allow" },

      { "name": "cat .env", "input": { "command": "cat .env" }, "expect": "deny", "match": "credential" },
      { "name": "cat nested .env.production", "input": { "command": "cat apps/web/.env.production" }, "expect": "deny" },
      { "name": "grep in .dev.vars", "input": { "command": "grep KEY .dev.vars" }, "expect": "deny" },
      { "name": "cp .env.local", "input": { "command": "cp .env.local /tmp/x" }, "expect": "deny" },
      { "name": "--env-file=.env", "input": { "command": "node --env-file=.env app.js" }, "expect": "deny" },
      { "name": "node -e reading .env", "input": { "command": "node -e \"require('fs').readFileSync('.env','utf8')\"" }, "expect": "deny" },
      { "name": "redirect target .env", "input": { "command": "echo KEY=1 > .env" }, "expect": "deny" },
      { "name": "command substitution reading .env", "input": { "command": "echo $(cat .env)" }, "expect": "deny" },
      { "name": "glob .env*", "input": { "command": "cat .env*" }, "expect": "deny" },
      { "name": "ssh private key", "input": { "command": "cat ~/.ssh/id_ed25519" }, "expect": "deny" },
      { "name": "private pem", "input": { "command": "cat deploy/key.pem" }, "expect": "deny" },
      { "name": ".credentials.json", "input": { "command": "type C:\\Users\\x\\.claude\\.credentials.json" }, "expect": "deny" },
      { "name": "PowerShell Get-Content .env.local", "tool": "PowerShell", "input": { "command": "Get-Content .env.local" }, "expect": "deny" },
      { "name": "PowerShell Get-Content -Path quoted", "tool": "PowerShell", "input": { "command": "Get-Content -Path \"C:\\p\\.env\"" }, "expect": "deny" },
      { "name": "PowerShell gc .dev.vars", "tool": "PowerShell", "input": { "command": "gc .dev.vars | Select-String KEY" }, "expect": "deny" },
      { "name": "PowerShell message is data", "tool": "PowerShell", "input": { "command": "git commit -m \"mention .env in docs\"" }, "expect": "allow" },
      { "name": "Read .env", "tool": "Read", "input": { "file_path": "C:/p/.env" }, "expect": "deny" },
      { "name": "Read .env.local", "tool": "Read", "input": { "file_path": "C:\\p\\.env.local" }, "expect": "deny" },
      { "name": "Read .dev.vars", "tool": "Read", "input": { "file_path": "C:/p/.dev.vars" }, "expect": "deny" },
      { "name": "Read ssh key", "tool": "Read", "input": { "file_path": "C:/Users/x/.ssh/id_rsa" }, "expect": "deny" },
      { "name": "Grep path .env.local", "tool": "Grep", "input": { "pattern": "KEY", "path": "C:/p/.env.local" }, "expect": "deny" },
      { "name": "Grep glob .env*", "tool": "Grep", "input": { "pattern": "KEY", "glob": ".env*" }, "expect": "deny" },
      { "name": "Glob pattern **/.env", "tool": "Glob", "input": { "pattern": "**/.env" }, "expect": "deny" }
    ]
  }
]
