  "cases": [
   {
    "name": "approved set covers every pending file: db push",
    "tool": "Bash",
    "input": {
     "command": "supabase db push"
    },
    "expect": "allow"
   },
   {
    "name": "approved set covers: migration up --linked",
    "tool": "Bash",
    "input": {
     "command": "supabase migration up --linked"
    },
    "expect": "allow"
   },
   {
    "name": "approved set covers: npx",
    "tool": "Bash",
    "input": {
     "command": "cd \"{ROOT}\" && npx supabase db push"
    },
    "expect": "allow"
   },
   {
    "name": "older file below the approved minimum is ignored",
    "tool": "Bash",
    "input": {
     "command": "supabase db push"
    },
    "expect": "allow"
   },
   {
    "name": "repair of approved versions",
    "tool": "Bash",
    "input": {
     "command": "supabase migration repair --status applied 20261004120000 20261004130000"
    },
    "expect": "allow"
   },
   {
    "name": "repair of one approved version",
    "tool": "Bash",
    "input": {
     "command": "supabase migration repair --status reverted 20261004130000"
    },
    "expect": "allow"
   },
   {
    "name": "repair of a version not approved",
    "tool": "Bash",
    "input": {
     "command": "supabase migration repair --status applied 20261001000000"
    },
    "expect": "deny",
    "match": "not approved.*20261001000000"
   },
   {
    "name": "repair of approved + unapproved mix",
    "tool": "Bash",
    "input": {
