     "command": "supabase db push --db-url postgresql://postgres:postgres@host.docker.internal:54322/postgres"
    },
    "expect": "allow"
   },
   {
    "name": "db-url remote host",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --db-url postgresql://postgres:pw@db.prodref0000000000000.supabase.co:5432/postgres"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "db-url remote unknown host",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --db-url postgresql://u:p@db.example.com:5432/postgres"
    },
    "expect": "deny",
    "match": "cannot be determined"
   },
   {
    "name": "db-url localhost lookalike",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --db-url postgresql://u:p@localhost.evil.com:5432/postgres"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "db-url userinfo spoofing localhost",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --db-url postgresql://localhost:x@evil.com:5432/postgres"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "db-url localhost with host= override",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --db-url \"postgresql://u:p@localhost/postgres?host=evil.com\""
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "db-url from a shell variable",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --db-url \"$DB_URL\""
    },
    "expect": "deny",
    "match": "cannot be determined"
   },
   {
    "name": "db-url to a DEV project host",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --db-url postgresql://postgres:pw@db.devref00000000000000.supabase.co:5432/postgres"
    },
    "expect": "allow"
   },
   {
    "name": "fake dev ref in username on a foreign host",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --db-url postgresql://postgres.devref00000000000000:pw@evil.example.com:5432/postgres"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "unrelated supabase command",
    "tool": "Bash",
    "input": {
     "command": "supabase functions list"
    },
    "expect": "allow"
   }
  ]
