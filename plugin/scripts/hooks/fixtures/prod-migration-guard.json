[
 {
  "setup": {
   "config": {
    "project": {
     "name": "t",
     "slug": "t"
    },
    "supabase": {
     "devProjectRefs": [
      "devref00000000000000"
     ],
     "prodProjectRefs": [
      "prodref0000000000000"
     ]
    }
   },
   "git": true,
   "files": {
    "supabase/config.toml": "",
    "supabase/migrations/20261001000000_a.sql": "--",
    "supabase/migrations/20261004120000_b.sql": "--",
    "supabase/migrations/20261004130000_c.sql": "--",
    "supabase/.temp/project-ref": "prodref0000000000000"
   }
  },
  "cases": [
   {
    "name": "prod linked: db push, no approval",
    "tool": "Bash",
    "input": {
     "command": "supabase db push"
    },
    "expect": "deny",
    "match": "no owner approval"
   },
   {
    "name": "deny message carries the issuing command",
    "tool": "Bash",
    "input": {
     "command": "supabase db push"
    },
    "expect": "deny",
    "match": "approve-prod-migration.mjs.*--project-ref prodref0000000000000"
   },
   {
    "name": "db push --linked, no approval",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --linked"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "npx wrapper",
    "tool": "Bash",
    "input": {
     "command": "cd \"{ROOT}\" && npx supabase db push"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "npx -y supabase@latest",
    "tool": "Bash",
    "input": {
     "command": "cd \"{ROOT}\" && npx -y supabase@latest db push"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "pnpm dlx wrapper",
    "tool": "Bash",
    "input": {
     "command": "cd \"{ROOT}\" && pnpm dlx supabase db push"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "bunx wrapper",
    "tool": "Bash",
    "input": {
     "command": "cd \"{ROOT}\" && bunx supabase db push"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "local binary path",
    "tool": "Bash",
    "input": {
     "command": "./node_modules/.bin/supabase db push"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "bash -c wrapper",
    "tool": "Bash",
    "input": {
     "command": "bash -c \"supabase db push\""
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "chained after cd and &&",
    "tool": "Bash",
    "input": {
     "command": "cd . && supabase db push --linked"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "PowerShell",
    "tool": "PowerShell",
    "input": {
     "command": "supabase db push"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "PowerShell npx",
    "tool": "PowerShell",
    "input": {
     "command": "cd \"{ROOT}\" && npx supabase db push"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "global flags before the subcommand",
    "tool": "Bash",
    "input": {
     "command": "supabase --debug --workdir . db push"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "migration up --linked",
    "tool": "Bash",
    "input": {
     "command": "supabase migration up --linked"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "migration repair names a version",
    "tool": "Bash",
    "input": {
     "command": "supabase migration repair --status applied 20261004120000"
    },
    "expect": "deny",
    "match": "approve-prod-migration.mjs.*20261004120000"
   },
   {
    "name": "migration repair names no version",
    "tool": "Bash",
    "input": {
     "command": "supabase migration repair --status applied"
    },
    "expect": "deny",
    "match": "names no migration version"
   },
   {
    "name": "db reset --linked is always denied",
    "tool": "Bash",
    "input": {
     "command": "supabase db reset --linked"
    },
    "expect": "deny",
    "match": "WIPE"
   },
   {
    "name": "db reset --db-url remote",
    "tool": "Bash",
    "input": {
     "command": "supabase db reset --db-url postgresql://postgres:pw@db.prodref0000000000000.supabase.co:5432/postgres"
    },
    "expect": "deny",
    "match": "WIPE"
   },
   {
    "name": "db push --include-all",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --include-all"
    },
    "expect": "deny",
    "match": "include-all"
   },
   {
    "name": "db push --include-seed",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --include-seed"
    },
    "expect": "deny",
    "match": "seed"
   },
   {
    "name": "explicit --project-ref prod",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --project-ref prodref0000000000000"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "--project-ref unknown",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --project-ref unknownref0000000000"
    },
    "expect": "deny",
    "match": "prod-migration-guard"
   },
   {
    "name": "--project-ref dev while linked to prod",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --project-ref devref00000000000000"
    },
    "expect": "allow"
   },
   {
    "name": "--local is allowed",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --local"
    },
    "expect": "allow"
   },
   {
    "name": "--dry-run is allowed",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --dry-run"
    },
    "expect": "allow"
   },
   {
    "name": "--dry-run --linked is allowed",
    "tool": "Bash",
    "input": {
     "command": "supabase db push --linked --dry-run"
    },
    "expect": "allow"
   },
   {
    "name": "migration up defaults to LOCAL",
    "tool": "Bash",
    "input": {
     "command": "supabase migration up"
    },
    "expect": "allow"
   },
   {
    "name": "db reset (local) is allowed",
    "tool": "Bash",
    "input": {
     "command": "supabase db reset"
    },
    "expect": "allow"
   },
   {
    "name": "migration list is not a trigger",
    "tool": "Bash",
    "input": {
     "command": "supabase migration list --linked"
    },
    "expect": "allow"
   },
   {
    "name": "db pull is not a trigger",
    "tool": "Bash",
    "input": {
     "command": "supabase db pull"
    },
    "expect": "allow"
   },
   {
    "name": "echoing the command is data",
    "tool": "Bash",
    "input": {
     "command": "echo supabase db push"
    },
    "expect": "allow"
   },
   {
    "name": "grep for the command is a read",
    "tool": "Bash",
    "input": {
     "command": "grep -rn 'supabase db push' docs"
    },
    "expect": "allow"
   },
   {
    "name": "git commit message mentioning it",
    "tool": "Bash",
    "input": {
     "command": "git commit -m \"docs: supabase db push needs approval\""
    },
    "expect": "allow"
   },
   {
    "name": "db-url localhost",
    "tool": "Bash",
    "input": {
