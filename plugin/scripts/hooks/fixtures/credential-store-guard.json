[
  {
    "setup": {},
    "cases": [
      { "name": "PS: Get-StoredCredential", "tool": "PowerShell", "input": { "command": "Get-StoredCredential -Target 'P-Cloudflare-API-Token'" }, "expect": "deny", "match": "D085.*maple-secret|Get-StoredCredential" },
      { "name": "PS: lower-case get-storedcredential in assignment", "tool": "PowerShell", "input": { "command": "$c = get-storedcredential -target x" }, "expect": "deny", "match": "Get-StoredCredential" },
      { "name": "PS: GetNetworkCredential().Password", "tool": "PowerShell", "input": { "command": "$env:T = (Get-StoredCredential -Target x).GetNetworkCredential().Password" }, "expect": "deny" },
      { "name": "PS: $cred.GetNetworkCredential only", "tool": "PowerShell", "input": { "command": "$cred.GetNetworkCredential() | Out-Null" }, "expect": "deny", "match": "GetNetworkCredential" },
      { "name": "PS: (Get-Credential).Password", "tool": "PowerShell", "input": { "command": "(Get-Credential).Password" }, "expect": "deny", "match": "Password" },
      { "name": "PS: $cred.Password", "tool": "PowerShell", "input": { "command": "$cred = Import-Clixml x.xml; $cred.Password" }, "expect": "deny", "match": "Password" },
      { "name": "PS: CredRead P/Invoke", "tool": "PowerShell", "input": { "command": "Add-Type -MemberDefinition '[DllImport(\"advapi32.dll\", CharSet=CharSet.Unicode)] public static extern bool CredRead(string t, int type, int f, out IntPtr c);' -Name N -Namespace W" }, "expect": "deny", "match": "CredRead" },
      { "name": "PS: CredEnumerate", "tool": "PowerShell", "input": { "command": "[W.N]::CredEnumerate($null, 0, [ref]$n, [ref]$p)" }, "expect": "deny", "match": "CredEnumerate" },
      { "name": "PS: PasswordVault", "tool": "PowerShell", "input": { "command": "$v = New-Object Windows.Security.Credentials.PasswordVault; $v.RetrieveAll()" }, "expect": "deny", "match": "PasswordVault" },
      { "name": "PS: vaultcmd", "tool": "PowerShell", "input": { "command": "vaultcmd /listcreds:\"Windows Credentials\" /all" }, "expect": "deny", "match": "vaultcmd" },
      { "name": "PS: PtrToStringBSTR", "tool": "PowerShell", "input": { "command": "[Runtime.InteropServices.Marshal]::PtrToStringBSTR($ptr)" }, "expect": "deny", "match": "PtrToString" },
      { "name": "PS: PtrToStringAuto", "tool": "PowerShell", "input": { "command": "[System.Runtime.InteropServices.Marshal]::PtrToStringAuto($p)" }, "expect": "deny" },
      { "name": "PS: SecureStringToBSTR", "tool": "PowerShell", "input": { "command": "$p = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($s)" }, "expect": "deny" },
      { "name": "PS: ConvertFrom-SecureString -AsPlainText", "tool": "PowerShell", "input": { "command": "$s | ConvertFrom-SecureString -AsPlainText" }, "expect": "deny", "match": "AsPlainText" },
      { "name": "PS: cmdkey /generic ... /pass (write)", "tool": "PowerShell", "input": { "command": "cmdkey /generic:P-X /user:u /pass:synthetic" }, "expect": "deny", "match": "cmdkey" },
      { "name": "PS: cmdkey /add", "tool": "PowerShell", "input": { "command": "cmdkey /add:host /user:u" }, "expect": "deny" },
      { "name": "PS: powershell -Command wrapper from Bash", "tool": "Bash", "input": { "command": "powershell -NoProfile -Command \"(Get-StoredCredential -Target x).GetNetworkCredential().Password\"" }, "expect": "deny" },
      { "name": "Bash: security find-generic-password -w", "tool": "Bash", "input": { "command": "security find-generic-password -s my-service -w" }, "expect": "deny", "match": "security find" },
      { "name": "Bash: security find-internet-password -g", "tool": "Bash", "input": { "command": "security find-internet-password -a me -g" }, "expect": "deny" },
      { "name": "Bash: secret-tool lookup", "tool": "Bash", "input": { "command": "TOKEN=$(secret-tool lookup service x user y)" }, "expect": "deny", "match": "secret-tool" },
      { "name": "Bash: node -e importing credentials.mjs", "tool": "Bash", "input": { "command": "node -e \"import('./plugin/scripts/predeploy/credentials.mjs').then(m=>console.log(m.getCredential('x')))\"" }, "expect": "deny", "match": "credentials.mjs" },
      { "name": "Bash: node --input-type=module getCredential(", "tool": "Bash", "input": { "command": "node --input-type=module -e \"import {getCredential} from '/p/credentials.mjs'; process.stdout.write(getCredential('T'))\"" }, "expect": "deny" },
      { "name": "Bash: heredoc into powershell", "tool": "Bash", "input": { "command": "powershell -NoProfile -Command - <<'EOF'\n(Get-StoredCredential -Target x).GetNetworkCredential().Password\nEOF" }, "expect": "deny" },
      { "name": "PS: here-string into iex", "tool": "PowerShell", "input": { "command": "$s = @'\n(Get-StoredCredential -Target x).Password\n'@\nInvoke-Expression $s" }, "expect": "deny" },
      { "name": "Bash: -EncodedCommand carrying Get-StoredCredential", "tool": "Bash", "input": { "command": "powershell -EncodedCommand RwBlAHQALQBTAHQAbwByAGUAZABDAHIAZQBkAGUAbgB0AGkAYQBsACAALQBUAGEAcgBnAGUAdAAgAHgA" }, "expect": "deny", "match": "Get-StoredCredential" },
      { "name": "PS: Write-Host of a credential expression", "tool": "PowerShell", "input": { "command": "Write-Host $cred.GetNetworkCredential().Password" }, "expect": "deny" },
      { "name": "MCP shell: Get-StoredCredential", "tool": "mcp__Windows-MCP__PowerShell", "input": { "command": "(Get-StoredCredential -Target x).GetNetworkCredential().Password" }, "expect": "deny", "match": "D085" },
      { "name": "MCP shell: cmdkey write", "tool": "mcp__Windows-MCP__PowerShell", "input": { "command": "cmdkey /generic:t /user:u /pass:p" }, "expect": "deny" },
      { "name": "MCP shell: P/Invoke CredRead", "tool": "mcp__Windows-MCP__PowerShell", "input": { "command": "Add-Type -TypeDefinition 'public class C { [DllImport(\"advapi32.dll\")] static extern bool CredReadW(); }'" }, "expect": "deny" },
      { "name": "MCP run_in_terminal: vaultcmd", "tool": "mcp__terminal__run_in_terminal", "input": { "command": "vaultcmd /listcreds:\"Web Credentials\"" }, "expect": "deny" },

      { "name": "allow: cmdkey /list", "tool": "PowerShell", "input": { "command": "cmdkey /list" }, "expect": "allow" },
      { "name": "allow: cmdkey /list:target (Bash)", "tool": "Bash", "input": { "command": "cmdkey /list:P-Cloudflare-API-Token" }, "expect": "allow" },
      { "name": "allow: maple-secret run (PowerShell)", "tool": "PowerShell", "input": { "command": "node \"$env:CLAUDE_PLUGIN_ROOT/scripts/secrets/maple-secret.mjs\" run --env CLOUDFLARE_API_TOKEN=P-Cloudflare-API-Token -- npx wrangler deploy" }, "expect": "allow" },
      { "name": "allow: maple-secret run --file (Bash)", "tool": "Bash", "input": { "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/secrets/maple-secret.mjs\" run --file KEYFILE=P-Gemini-API-Key -- node tool.mjs" }, "expect": "allow" },
      { "name": "allow: maple-secret exists / list", "tool": "Bash", "input": { "command": "node plugin/scripts/secrets/maple-secret.mjs exists P-X && node plugin/scripts/secrets/maple-secret.mjs list" }, "expect": "allow" },
      { "name": "allow: predeploy runner", "tool": "Bash", "input": { "command": "node plugin/scripts/predeploy/run.mjs --live" }, "expect": "allow" },
      { "name": "allow: predeploy test file named credentials.test.mjs", "tool": "Bash", "input": { "command": "node plugin/scripts/predeploy/credentials.test.mjs" }, "expect": "allow" },
      { "name": "allow: owner store-secret.ps1", "tool": "PowerShell", "input": { "command": "powershell -ExecutionPolicy Bypass -File \"$CLAUDE_PLUGIN_ROOT\\skills\\credential-manager\\scripts\\store-secret.ps1\" -Target P-Supabase-PAT" }, "expect": "allow" },
      { "name": "allow: commit message mentions the APIs", "tool": "Bash", "input": { "command": "git commit -m \"security: deny Get-StoredCredential, GetNetworkCredential().Password and CredRead (D085)\"" }, "expect": "allow" },
      { "name": "allow: commit -am message", "tool": "Bash", "input": { "command": "git commit -am \"docs: PasswordVault and vaultcmd are denied\"" }, "expect": "allow" },
      { "name": "allow: heredoc commit message", "tool": "Bash", "input": { "command": "git commit -m \"$(cat <<'EOF'\nfix: guard Get-StoredCredential, secret-tool lookup and credentials.mjs imports\nEOF\n)\"" }, "expect": "allow" },
      { "name": "allow: gh pr body", "tool": "Bash", "input": { "command": "gh pr create --title \"guard\" --body \"Denies Get-StoredCredential and PtrToStringBSTR\"" }, "expect": "allow" },
      { "name": "allow: echo string", "tool": "Bash", "input": { "command": "echo \"never call Get-StoredCredential or GetNetworkCredential directly\"" }, "expect": "allow" },
      { "name": "allow: Write-Host string", "tool": "PowerShell", "input": { "command": "Write-Host \"Get-StoredCredential is denied, use maple-secret\"" }, "expect": "allow" },
      { "name": "allow: grep for the name", "tool": "Bash", "input": { "command": "grep -rn Get-StoredCredential plugin/" }, "expect": "allow" },
      { "name": "allow: rg for the names", "tool": "Bash", "input": { "command": "rg -n \"GetNetworkCredential|CredRead|PasswordVault\" plugin docs" }, "expect": "allow" },
      { "name": "allow: git grep", "tool": "Bash", "input": { "command": "git grep -n \"Get-StoredCredential\" -- plugin" }, "expect": "allow" },
      { "name": "allow: Select-String in PowerShell", "tool": "PowerShell", "input": { "command": "Get-ChildItem -Recurse plugin | Select-String -Pattern 'GetNetworkCredential'" }, "expect": "allow" },
      { "name": "allow: heredoc body mentioning names, no interpreter", "tool": "Bash", "input": { "command": "cat > notes.txt <<'EOF'\nGet-StoredCredential and vaultcmd are denied\nEOF" }, "expect": "allow" },
      { "name": "allow: ordinary node and PowerShell", "tool": "PowerShell", "input": { "command": "node -e \"console.log(process.env.NODE_ENV)\"; Get-ChildItem" }, "expect": "allow" },
      { "name": "allow: process.env.PASSWORD-ish config in node", "tool": "Bash", "input": { "command": "node -e \"console.log(Object.keys(config).length)\"" }, "expect": "allow" },
      { "name": "allow: Bash .password text outside PowerShell", "tool": "Bash", "input": { "command": "jq .user.password package.json" }, "expect": "allow" }
    ]
  }
]
