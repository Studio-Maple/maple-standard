[
  {
    "setup": {},
    "cases": [
      { "name": "echo a secret var", "input": { "command": "echo $GITHUB_TOKEN" }, "expect": "deny", "match": "secret-shell-guard" },
      { "name": "echo braced secret var in a string", "input": { "command": "echo \"token is ${STRIPE_SECRET_KEY}\"" }, "expect": "deny" },
      { "name": "printf a password", "input": { "command": "printf '%s' \"$DB_PASSWORD\"" }, "expect": "deny" },
      { "name": "PowerShell bare $env statement", "tool": "PowerShell", "input": { "command": "$env:CLOUDFLARE_API_TOKEN" }, "expect": "deny" },
      { "name": "PowerShell Write-Output $env", "tool": "PowerShell", "input": { "command": "Write-Output $env:SUPABASE_ACCESS_TOKEN" }, "expect": "deny" },
      { "name": "PowerShell Get-Item env:X", "tool": "PowerShell", "input": { "command": "Get-Item env:OPENAI_API_KEY" }, "expect": "deny" },
      { "name": "PowerShell gci env: dump", "tool": "PowerShell", "input": { "command": "gci env:" }, "expect": "deny", "match": "env:" },
      { "name": "PowerShell Get-ChildItem Env:\\ dump", "tool": "PowerShell", "input": { "command": "Get-ChildItem Env:{BS}" }, "expect": "deny" },
      { "name": "MCP PowerShell $env statement", "tool": "mcp__Windows-MCP__PowerShell", "input": { "command": "$env:NPM_TOKEN" }, "expect": "deny" },
      { "name": "bare env dump", "input": { "command": "env" }, "expect": "deny", "match": "environment" },
      { "name": "env piped to grep", "input": { "command": "env | grep SUPABASE" }, "expect": "deny" },
      { "name": "bare printenv", "input": { "command": "printenv" }, "expect": "deny" },
      { "name": "printenv of a secret", "input": { "command": "printenv VERCEL_TOKEN" }, "expect": "deny" },
      { "name": "bare set dump", "input": { "command": "set | head" }, "expect": "deny" },
      { "name": "export -p", "input": { "command": "export -p" }, "expect": "deny" },
      { "name": "node one-liner printing a token", "input": { "command": "node -e \"console.log(process.env.NPM_TOKEN)\"" }, "expect": "deny", "match": "inline" },
      { "name": "python one-liner printing a secret", "input": { "command": "python -c \"import os; print(os.environ['DJANGO_SECRET_KEY'])\"" }, "expect": "deny" },
      { "name": "gh auth token", "input": { "command": "gh auth token" }, "expect": "deny", "match": "gh auth token" },
      { "name": "gh auth status --show-token", "input": { "command": "gh auth status --show-token" }, "expect": "deny" },
      { "name": "gcloud print-access-token", "input": { "command": "gcloud auth print-access-token" }, "expect": "deny" },
      { "name": "aws configure get secret", "input": { "command": "aws configure get aws_secret_access_key" }, "expect": "deny" },
      { "name": "aws sts get-session-token", "input": { "command": "aws sts get-session-token --duration-seconds 900" }, "expect": "deny" },
      { "name": "op read", "input": { "command": "op read op://vault/item/password" }, "expect": "deny" },
      { "name": "cat aws credentials", "input": { "command": "cat ~/.aws/credentials" }, "expect": "deny" },
      { "name": "type git-credentials", "tool": "PowerShell", "input": { "command": "Get-Content $HOME/.git-credentials" }, "expect": "deny" },
      { "name": "cat .netrc", "input": { "command": "cat ~/.netrc" }, "expect": "deny" },

      { "name": "using a token in a header is fine", "input": { "command": "curl -sS -H \"Authorization: Bearer $GITHUB_TOKEN\" https://api.github.com/user -o /dev/null -w '%{http_code}'" }, "expect": "allow" },
      { "name": "presence check is fine", "input": { "command": "[ -n \"$GITHUB_TOKEN\" ] && echo set || echo missing" }, "expect": "allow" },
      { "name": "PowerShell presence check", "tool": "PowerShell", "input": { "command": "[bool]$env:GITHUB_TOKEN" }, "expect": "allow" },
      { "name": "echo a non-secret var", "input": { "command": "echo $PATH $HOME $NODE_ENV" }, "expect": "allow" },
      { "name": "echo a public key var", "input": { "command": "echo $NEXT_PUBLIC_SUPABASE_ANON_KEY" }, "expect": "allow" },
      { "name": "commit message mentioning echo $TOKEN", "input": { "command": "git commit -m \"docs: never run echo $TOKEN or env\"" }, "expect": "allow" },
      { "name": "set -euo pipefail", "input": { "command": "set -euo pipefail; ls" }, "expect": "allow" },
      { "name": "env prefix running a command", "input": { "command": "env NODE_ENV=test node -v" }, "expect": "allow" },
      { "name": "node one-liner reading a non-secret", "input": { "command": "node -e \"console.log(process.env.NODE_ENV)\"" }, "expect": "allow" },
      { "name": "node one-liner using a token without printing", "input": { "command": "node -e \"fetch(u,{headers:{a:process.env.API_TOKEN}})\"" }, "expect": "allow" },
      { "name": "gh auth status without token", "input": { "command": "gh auth status" }, "expect": "allow" },
      { "name": "grep for the word token in code", "input": { "command": "grep -rn GITHUB_TOKEN .github/workflows" }, "expect": "allow" },
      { "name": "known_hosts append", "input": { "command": "ssh-keyscan github.com >> ~/.ssh/known_hosts" }, "expect": "allow" },
      { "name": "printenv a non-secret", "input": { "command": "printenv HOME" }, "expect": "allow" },
      { "name": "echo a secret into a stdin CLI is denied", "input": { "command": "echo $DOCKER_PASSWORD | docker login ghcr.io -u me --password-stdin" }, "expect": "deny" },
      { "name": "stdin CLI fed inside maple-secret is allowed", "input": { "command": "node plugin/scripts/secrets/maple-secret.mjs run --env P=Proj-Docker-Token -- bash -c 'printf %s \"$P\" | docker login ghcr.io -u me --password-stdin'" }, "expect": "allow" }
    ]
  }
]
