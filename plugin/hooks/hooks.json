{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scrub-secrets.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Write|Edit|MultiEdit|mcp__.*__(apply_migration|execute_sql|deploy_edge_function|merge_branch|reset_branch|rebase_branch|delete_branch|pause_project|restore_project)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/jev-validate-subagent.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
