#!/bin/sh

# Pre-commit: staged-file lint + migration naming ONLY (D066). The affected-only gate runs at
# push / landing (.husky/pre-push); the heavy tier runs batched (docs/quality.md).

echo "Pre-commit: checking staged files..."

# Self-heal: `pnpm install`/husky resets core.hooksPath to the relative .husky/_ ;
# this puts back the absolute, fail-closed one (and the stubs in every worktree).
node scripts/install-hooks.mjs --quiet >/dev/null 2>&1 || true

# Parallel-session collision WARN (non-blocking, default-on, opt-out).
# Committing from a shared main checkout while other git worktrees are active
# risks a whole-index commit sweeping in another session's staged files.
# Warn; never block. Silence: MAPLE_PARALLEL_WARN=off.
if ! echo "${MAPLE_PARALLEL_WARN:-}" | grep -qiE '^(off|0|false)$'; then
  GITDIR=$(git rev-parse --absolute-git-dir 2>/dev/null || echo "")
  case "$GITDIR" in
    */worktrees/*) : ;;  # already isolated in a worktree — no warning
    *)
      WT_TOTAL=$(git worktree list 2>/dev/null | wc -l | tr -d ' ')
      if [ "${WT_TOTAL:-1}" -gt 1 ]; then
        echo "  WARN: $((WT_TOTAL - 1)) parallel git worktree(s) active — committing from the MAIN tree."
        echo "    A whole-index commit can sweep in another session's staged files. Scope it: git commit -- <paths>."
        echo "    (warning only — silence with MAPLE_PARALLEL_WARN=off)"
      fi
      ;;
  esac
fi

# Migration filename validation: YYYYMMDDHHMMSS_description.sql
# (.sql files only — the directory's README documenting the convention is fine)
MIGRATIONS=$(git diff --cached --name-only | grep 'supabase/migrations/.*\.sql$' || true)
if [ -n "$MIGRATIONS" ]; then
  for f in $MIGRATIONS; do
    base=$(basename "$f")
    if ! echo "$base" | grep -qE '^[0-9]{14}_[a-z0-9_]+\.sql$'; then
      echo "ERROR: Migration file '$base' does not match naming convention: YYYYMMDDHHMMSS_description.sql"
      exit 1
    fi
  done
  echo "  Migration file naming: OK"
fi

# Staged-file lint ONLY (D066) - same flags as the gate, so a green commit cannot go red at push for lint.
# No tsc here: a cold whole-project typecheck made every commit slow; types are checked by the gate
# (affected-only) at push/landing. Edge Function typecheck (Deno) moved to the heavy tier.
STAGED_LINT=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx|mts|js|jsx|mjs|cjs)$' | grep -vE '^(\.next|node_modules|\.worktrees|playwright-report|test-results)/' || true)
if [ -n "$STAGED_LINT" ]; then
  echo "  staged files - running lint (--max-warnings=0)..."
  # one arg per staged file (xargs: no unquoted word splitting)
  printf '%s\n' "$STAGED_LINT" | xargs pnpm exec eslint --cache --max-warnings=0 --no-warn-ignored || exit 1
  echo "  Lint: OK"
fi

echo "Pre-commit checks passed!"
