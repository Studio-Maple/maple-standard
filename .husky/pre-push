#!/bin/sh

# Pre-push GATE (D066): the affected-only fast tier - no Docker, no live tier, no plugin
# integration suites. You cannot push red code - the gate is the enforcement, not trust
# (see CLAUDE.md "No bypass"). The expensive half (live RLS, E2E, integration suites, Jev audit)
# is the heavy tier: batched daily and before production promotion (pnpm ci:heavy).
#
# Genuinely-impossible steps are skipped ONLY for a listed reason, recorded as gate debt (paid by
# the next green heavy run; production promotion needs zero debt) - NOT --no-verify, which is forbidden:
#   MAPLE_GATE_SKIP=registry-unreachable git push     (dep-freshness; verified: the registry does not answer)

# AFFECTED-ONLY: CI_PREPUSH=1 makes ci-local.sh read the pushed refs git feeds
# on stdin, so only the checks this push can affect run (every step prints
# "ran" / "skipped (reason)"). Force everything: CI_FULL=1 git push
# (or `pnpm ci:gate -- --full`). A tree that already passed `gate`
# (e.g. /wt-land just ran it) is not re-run.
# Self-heal: `pnpm install`/husky resets core.hooksPath to the relative .husky/_ ;
# this puts back the absolute, fail-closed one (and the stubs in every worktree).
node scripts/install-hooks.mjs --quiet >/dev/null 2>&1 || true

echo "Pre-push: running the affected-only gate (fast tier; live RLS/E2E is the heavy tier)..."
CI_PREPUSH=1 CI_PREPUSH_REMOTE="$1" bash scripts/ci-local.sh gate || {
  echo ""
  echo "Pre-push BLOCKED - gate failed. Fix it. (A step that is genuinely impossible on this machine can be"
  echo "skipped with MAPLE_GATE_SKIP=<reason> - see scripts/ci-local.sh; it is recorded as gate debt.)"
  exit 1
}
echo "Pre-push gate passed."
