# Copy to .env.local (gitignored, agent-read-blocked) and fill in.
# NEVER commit real values. Server-only vars must NOT be NEXT_PUBLIC_.

# ── Supabase (Project Settings -> API) ──────────────────────────────────
# Local stack values: `supabase status -o env` after `pnpm supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Sentry (optional — errors log to console without it) ────────────────
# DSNs are public-by-design (write-only ingest); still keep them in env so
# each environment points at its own project.
# NEXT_PUBLIC_SENTRY_DSN=

# Source-map upload at build time (Vercel env vars, not local):
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=   <- secret; Vercel/CI env only, never .env.local

# ── Server-only (examples — add as your project grows) ──────────────────
# SUPABASE_SERVICE_ROLE_KEY=   <- NEVER NEXT_PUBLIC_, never on the client
